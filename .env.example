# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="FERTI FLORA - Ordem de Carregamento"

# WuzAPI (envio automático de WhatsApp) — self-hosted, ver deploy/wuzapi/
# Nunca prefixar com NEXT_PUBLIC_: só é usado em rotas de API (server-side).
WUZAPI_BASE_URL=https://seu-endereco-wuzapi.exemplo.com
WUZAPI_TOKEN=token_do_numero_conectado
