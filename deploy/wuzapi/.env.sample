# Copie para ".env" nesta mesma pasta e preencha antes de rodar
# "docker compose up -d --build".

# Token de admin do WuzAPI (cria/gerencia usuários/números). Gere um valor
# aleatório forte, ex.: openssl rand -hex 32
WUZAPI_ADMIN_TOKEN=

# Chave de criptografia AES-256 (32 bytes). Gere com: openssl rand -hex 32
WUZAPI_GLOBAL_ENCRYPTION_KEY=

# Subdomínio criado em https://www.duckdns.org (login com GitHub/Google) —
# só o prefixo, sem ".duckdns.org". Ex.: se criou "fertiflora-wuzapi",
# coloque "fertiflora-wuzapi" aqui.
DUCKDNS_DOMAIN=

# Token da sua conta DuckDNS (aparece no topo da página duckdns.org depois
# de logar).
DUCKDNS_TOKEN=
